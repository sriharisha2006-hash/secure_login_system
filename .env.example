# Application Configuration
SECRET_KEY=change_this_to_a_secure_random_string_in_production
FLASK_ENV=development
FLASK_DEBUG=1

# Database Configuration
DATABASE_PATH=secure_login.db

# Security Settings
# Set to True when running on HTTPS in production
SESSION_COOKIE_SECURE=False

# Rate Limiting (5 failed attempts per 5 minutes)
RATE_LIMIT_LOGIN_MAX_ATTEMPTS=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=300

# Password Hashing Algorithm ('bcrypt' or 'argon2')
DEFAULT_HASH_ALGO=bcrypt
